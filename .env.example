# Application mode:
# Use "local" when running on your personal machine.
# Use "demo" for the public Streamlit deployment.
APP_MODE=local

# API keys must never be committed to GitHub.
# Optional: required only when using the OpenAI provider.
OPENAI_API_KEY=

# Optional: required only when using the Claude provider.
ANTHROPIC_API_KEY=

# Optional: required only when using the Gemini provider.
GEMINI_API_KEY=

# Optional configuration.
OPENAI_MODEL=gpt-4.1-mini
CLAUDE_MODEL=claude-haiku-4-5
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
